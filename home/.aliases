#!/usr/bin/env bash

# Show/hide hidden files in Finder
alias show="defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder"
alias hide="defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder"

# IP addresses
alias ip="dig +short myip.opendns.com @resolver1.opendns.com"
alias localip="ipconfig getifaddr en0"

# Git
alias ga="git add"
alias gc="git commit"
alias gp="git push origin HEAD"
alias gpd="git pull origin main"
alias gl="git log"
alias gs="git status"
alias gd="git diff"

open_repo() {
    open "$(git remote get-url origin | sed 's/:/\//' | sed 's/git@/https:\/\//' | sed 's/.git$//')"
}
alias opengit='open_repo'

cleanup_branches() {
    echo "The following local branches will be deleted (excluding 'main'):"
    git branch | grep -v "main" | sed 's/^/  /'

    echo -e "\nAre you sure you want to delete these branches? (y/N): "
    read -r response

    if [[ "$response" =~ ^[Yy]$ ]]; then
        git branch | grep -v "main" | xargs git branch -D
        echo "Branches deleted successfully."
    else
        echo "Operation cancelled."
    fi
}
alias cleanupgit='cleanup_branches'

# Docker
alias dup="docker compose up"

# Servers
alias s="ssh ubuntu@stridee.fit"

# AWS (profiles in ~/.aws/config): `awsdev` opens a shell with dev credentials,
# `awsdev pulumi preview` runs one command. Same for `awsprod`.
alias awsdev="aws-vault exec dev --"
alias awsprod="aws-vault exec prod --"

# Homebrew: install/uninstall AND record it in ~/dotfiles/Brewfile (committed + pushed)
DOTFILES="$HOME/dotfiles"
_dotfiles_commit() {
    git -C "$DOTFILES" add Brewfile &&
    git -C "$DOTFILES" commit -q -m "$1" &&
    { git -C "$DOTFILES" push -q || echo "(committed, push failed — run: git -C ~/dotfiles push)"; }
}
# usage: brewadd jq   |   brewadd --cask raycast
brewadd() {
    brew install "$@" && brew bundle add --file="$DOTFILES/Brewfile" "$@" && _dotfiles_commit "Add ${*: -1}"
}
brewrm() {
    brew uninstall "$@" && brew bundle remove --file="$DOTFILES/Brewfile" "$@" && _dotfiles_commit "Remove ${*: -1}"
}
